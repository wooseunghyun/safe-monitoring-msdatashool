# Dockerfile.whisper
FROM python:3.11-slim

# ffmpeg는 whisper 필수
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 의존성 먼저 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 프로젝트 전체 복사
COPY . .

# 기본 타임존 같은 건 필요하면 추가
# ENV TZ=Asia/Seoul

# whisper_worker 메인 루프 실행
CMD ["python", "-m", "scripts.server.whisper_worker"]
